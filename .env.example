# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is listed in .gitignore.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only — never prefix with NEXT_PUBLIC_, never expose to browser or logs.
# SUPABASE_SECRET_KEY is the current Supabase credential (Supabase is migrating to this
# by end of 2026). SUPABASE_SERVICE_ROLE_KEY is the legacy fallback.
# Required for trusted server/worker operations (job claim, complete, fail, recovery).
# Set one or both; SUPABASE_SECRET_KEY takes precedence when both are present.
SUPABASE_SECRET_KEY=your-secret-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI
OPENAI_API_KEY=sk-...

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
